; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="retrl"
run/main_scene="res://ui/screens/Shell.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EmulatorRegistry="*res://autoload/EmulatorRegistry.gd"
LibraryScanner="*res://autoload/LibraryScanner.gd"
UpdateManager="*res://autoload/UpdateManager.gd"
LaunchManager="*res://autoload/LaunchManager.gd"
ArtManager="*res://autoload/ArtManager.gd"
AchievementsManager="*res://autoload/AchievementsManager.gd"
ScreenshotManager="*res://autoload/ScreenshotManager.gd"
Navigator="*res://autoload/Navigator.gd"
InputManager="*res://autoload/InputManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_mouse_from_touch=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
